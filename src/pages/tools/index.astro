---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const tools = (await getCollection('tools')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Værktøj" description="Gratis fitness værktøjer og beregnere fra UrbanCoast.dk. BMI beregner, kalorieberegner, protein beregner og 1RM beregner.">
  <div class="category-hero">
    <div class="container">
      <h1>Værktøj</h1>
      <p>Gratis beregnere til din træning og kost</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="cards-grid">
        {tools.map(tool => (
          <div class="card">
            <div class="card-body">
              <a href={`/tools/${tool.slug}`}><h3>{tool.data.title}</h3></a>
              <p class="card-excerpt">{tool.data.description}</p>
              <a href={`/tools/${tool.slug}`} class="read-more" style="font-size:.85rem">Brug værktøjet →</a>
            </div>
          </div>
        ))}
        {tools.length === 0 && (
          <p style="color:#64748b;text-align:center;padding:3rem 0">Ingen værktøjer endnu. Kommer snart!</p>
        )}
      </div>
    </div>
  </section>
</Layout>