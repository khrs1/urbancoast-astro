---
import Layout from '../../layouts/Layout.astro';

const tools = [
  { slug: 'bmi-beregner', title: 'BMI beregner', description: 'Beregn dit BMI (Body Mass Index) hurtigt og nemt. Indtast din højde og vægt og få resultatet med det samme.' },
  { slug: 'kalorieberegner', title: 'Kalorieberegner', description: 'Beregn dit daglige kaloriebehov (TDEE) gratis. Få antal kalorier og makroer til vedligeholdelse, vægttab eller muskelopbygning.' },
  { slug: 'makro-beregner', title: 'Makro beregner', description: 'Beregn dine makroer (protein, kulhydrat og fedt) ud fra dit kaloriebehov og mål. Få fordelingen vist som graf.' },
  { slug: 'protein-beregner', title: 'Protein beregner', description: 'Beregn hvor meget protein du skal have om dagen. Indtast din vægt og aktivitetsniveau og få dit daglige proteinbehov.' },
  { slug: '1rm-beregner', title: '1RM beregner', description: 'Beregn din 1RM (one-repetition maximum) ud fra en vægt og antal repetitioner. Se også træningstabel.' },
  { slug: 'fedtprocent-beregner', title: 'Fedtprocent beregner', description: 'Beregn din fedtprocent med US Navy metoden. Indtast hals, livvidde og højde for at estimere din kropsfedt.' },
  { slug: 'idealvægt-beregner', title: 'Idealvægt beregner', description: 'Beregn din idealvægt ud fra højde og køn. Se hvilken vægt der er sund for dig og hvor meget du skal tabe eller tage på.' },
  { slug: 'kreatin-beregner', title: 'Kreatin beregner', description: 'Beregn din kreatin dosis ud fra kropsvægt. Se loading fase og vedligeholdelses dosis.' },
  { slug: 'vand-beregner', title: 'Vand beregner', description: 'Beregn hvor meget vand du skal drikke om dagen. Indtast din vægt og aktivitetsniveau og få dit daglige væskebehov.' },
  { slug: 'pull-up-beregner', title: 'Pull up beregner', description: 'Se hvor mange pull ups du skal kunne for at nå dit næste mål. Får en progression plan fra begynder til øvet.' },
];
---

<Layout title="Værktøj" description="Gratis fitness værktøjer og beregnere fra UrbanCoast.dk. BMI beregner, kalorieberegner, protein beregner, 1RM beregner, makro beregner og mere.">
  <div class="category-hero">
    <div class="container">
      <h1>Værktøj</h1>
      <p>Gratis beregnere til din træning og kost</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="cards-grid">
        {tools.map(tool => (
          <div class="card">
            <div class="card-body">
              <a href={`/tools/${tool.slug}`}><h3>{tool.title}</h3></a>
              <p class="card-excerpt">{tool.description}</p>
              <a href={`/tools/${tool.slug}`} class="read-more" style="font-size:.85rem">Brug værktøjet →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>