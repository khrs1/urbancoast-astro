---
import Layout from '../../layouts/Layout.astro';

const date = new Date('2026-08-04');
const formattedDate = new Intl.DateTimeFormat('da-DK', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---

<Layout
  title="Fedtprocent beregner"
  description="Beregn din fedtprocent ud fra målinger. Brug US Navy metoden med livvidde, hals og højde til at estimere din kropsfedt."
  type="article"
  publishedTime="2026-08-04T00:00:00.000Z"
  author="Karsten Hansen"
>
  <div class="post-header">
    <div class="container">
      <div style="margin-bottom:.75rem"><a href="/tools" class="badge">Værktøj</a></div>
      <h1>Fedtprocent beregner</h1>
      <div class="post-meta">
        <span>Af <strong>Karsten Hansen</strong></span>
        <span class="sep">·</span>
        <span>{formattedDate}</span>
      </div>
    </div>
  </div>

  <article class="post-content" style="max-width:800px">
    <p>Beregn din estimerede fedtprocent med US Navy metoden. Det tager 2 minutter og kræver bare et målebånd.</p>

    <div id="bf-calculator">
      <div class="calc-inputs">
        <label for="bf-gender">Køn</label>
        <select id="bf-gender">
          <option value="male">Mand</option>
          <option value="female">Kvinde</option>
        </select>
        <label for="bf-height">Højde (cm)</label>
        <input type="number" id="bf-height" placeholder="180" min="100" max="250" />
        <label for="bf-neck">Hals omkreds (cm)</label>
        <input type="number" id="bf-neck" placeholder="38" min="20" max="80" step="0.5" />
        <label for="bf-waist">Livvidde (cm)</label>
        <input type="number" id="bf-waist" placeholder="85" min="40" max="200" step="0.5" />
        <div id="bf-hip-wrap" style="display:none">
          <label for="bf-hip">Hofte omkreds (cm)</label>
          <input type="number" id="bf-hip" placeholder="95" min="40" max="200" step="0.5" />
        </div>
        <button onclick="calculateBF()">Beregn fedtprocent</button>
      </div>
      <div id="bf-result" class="calc-result" style="display:none">
        <div id="bf-value"></div>
        <div id="bf-category"></div>
        <div id="bf-scale"></div>
        <div id="bf-info"></div>
      </div>
    </div>

    <h2>Hvad er fedtprocent?</h2>
    <p>Fedtprocent fortæller dig hvor meget af din kropsvægt der er fedt vs muskler og knogler. Det er meget mere præcist end <a href="/tools/bmi-beregner">BMI</a>, som ikke skelner mellem muskler og fedt.</p>
    <p>Læs mere i vores <a href="/ordbog/hvad-er-fedtprocent">fedtprocent ordbog</a>.</p>

    <h2>Sådan måler du</h2>
    <p>Brug et blødt målebånd. Mål uden tøj eller i undertøj for bedst resultat.</p>
    <ul>
      <li><strong>Hals:</strong> Mål lige under struben</li>
      <li><strong>Livvidde:</strong> Mål på navlen (mænd) eller det bredeste sted (kvinder)</li>
      <li><strong>Hofte (kun kvinder):</strong> Mål det bredeste sted på hoften</li>
    </ul>

    <h2>Fedtprocent skala</h2>
    <table>
      <thead><tr><th>Kategori</th><th>Mænd</th><th>Kvinder</th></tr></thead>
      <tbody>
        <tr><td>Atletisk</td><td>6-13%</td><td>14-20%</td></tr>
        <tr><td>Fitness</td><td>14-17%</td><td>21-24%</td></tr>
        <tr><td>Acceptabelt</td><td>18-24%</td><td>25-31%</td></tr>
        <tr><td>For højt</td><td>25%+</td><td>32%+</td></tr>
      </tbody>
    </table>
  </article>

  <div style="border-top:1px solid #e5e7eb;padding:2rem 0;margin:0 auto;max-width:780px;padding-left:1.5rem;padding-right:1.5rem">
    <a href="/tools" style="color:#22c55e;font-weight:600;font-size:.9rem">← Tilbage til alle værktøjer</a>
  </div>
</Layout>

<script is:inline>
document.getElementById('bf-gender').addEventListener('change', function() {
  document.getElementById('bf-hip-wrap').style.display = this.value === 'female' ? 'block' : 'none';
});

function calculateBF() {
  var gender = document.getElementById('bf-gender').value;
  var height = parseFloat(document.getElementById('bf-height').value);
  var neck = parseFloat(document.getElementById('bf-neck').value);
  var waist = parseFloat(document.getElementById('bf-waist').value);
  var hip = parseFloat(document.getElementById('bf-hip').value);
  
  if (!height || !neck || !waist) { alert('Udfyld alle felter'); return; }
  
  var bf;
  if (gender === 'male') {
    bf = 495 / (1.0324 - 0.19077 * Math.log10(waist - neck) + 0.15456 * Math.log10(height)) - 450;
  } else {
    if (!hip) { alert('Indtast hofte omkreds'); return; }
    bf = 495 / (1.29579 - 0.35004 * Math.log10(waist + hip - neck) + 0.22100 * Math.log10(height)) - 450;
  }
  
  bf = Math.round(bf * 10) / 10;
  if (bf < 3 || bf > 60) { alert('Tjek dine målinger. Resultatet virker urealistisk.'); return; }
  
  var category, color, info;
  if (gender === 'male') {
    if (bf < 6) { category = 'Essentielt fedt'; color = '#3b82f6'; info = 'Dette er det minimale fedt der er nødvendigt for at overleve.'; }
    else if (bf < 14) { category = 'Atletisk'; color = '#22c55e'; info = 'Du har en meget lav fedtprocent. typisk for konkurrenceatleter.'; }
    else if (bf < 18) { category = 'Fitness'; color = '#22c55e'; info = 'Du er i god form. Dette er et sundt niveau for aktive mennesker.'; }
    else if (bf < 25) { category = 'Acceptabelt'; color = '#f59e0b'; info = 'Din fedtprocent er acceptabel. Med lidt træning kan du komme i fitness-zonen.'; }
    else { category = 'For højt'; color = '#ef4444'; info = 'Din fedtprocent er høj. Et <a href="/blog/10-punkter-til-et-hurtigt-vaegttab">vægttab</a> på 0,5-1 kg/uge kan forbedre din sundhed.'; }
  } else {
    if (bf < 14) { category = 'Essentielt fedt'; color = '#3b82f6'; info = 'Dette er det minimale fedt der er nødvendigt.'; }
    else if (bf < 21) { category = 'Atletisk'; color = '#22c55e'; info = 'Du har en meget lav fedtprocent. Typisk for konkurrenceatleter.'; }
    else if (bf < 25) { category = 'Fitness'; color = '#22c55e'; info = 'Du er i god form. Dette er et sundt niveau for aktive kvinder.'; }
    else if (bf < 32) { category = 'Acceptabelt'; color = '#f59e0b'; info = 'Din fedtprocent er acceptabel.'; }
    else { category = 'For højt'; color = '#ef4444'; info = 'Din fedtprocent er høj. Et vægttab kan forbedre din sundhed.'; }
  }
  
  document.getElementById('bf-value').innerHTML = '<div style="font-size:0.9rem;color:#64748b;margin-bottom:0.25rem">Din estimerede fedtprocent:</div><span style="font-size:3rem;font-weight:900;color:' + color + '">' + bf + '%</span>';
  document.getElementById('bf-category').innerHTML = '<span style="font-size:1.5rem;font-weight:700;color:' + color + '">' + category + '</span>';
  
  var scale = '<div style="display:flex;height:12px;border-radius:6px;overflow:hidden;margin:1rem 0">';
  scale += '<div style="width:20%;background:#3b82f6"></div><div style="width:20%;background:#22c55e"></div><div style="width:20%;background:#22c55e"></div><div style="width:20%;background:#f59e0b"></div><div style="width:20%;background:#ef4444"></div>';
  scale += '</div>';
  var markerPos = Math.min(Math.max(bf / 40 * 100, 0), 100);
  scale += '<div style="position:relative;height:20px"><div style="position:absolute;left:' + markerPos + '%;transform:translateX(-50%);font-size:1.5rem">▼</div></div>';
  document.getElementById('bf-scale').innerHTML = scale;
  document.getElementById('bf-info').innerHTML = '<p style="margin-top:1rem;color:#475569">' + info + '</p>';
  document.getElementById('bf-result').style.display = 'block';
}
</script>

<style>
.calc-inputs{display:flex;flex-direction:column;gap:0.75rem;max-width:400px;margin:0 auto;padding:2rem;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0}
.calc-inputs label{font-weight:700;font-size:0.9rem;color:#0f172a}
.calc-inputs input,.calc-inputs select{padding:0.75rem 1rem;border-radius:8px;border:2px solid #e2e8f0;font-size:1rem;outline:none;background:#fff}
.calc-inputs input:focus,.calc-inputs select:focus{border-color:#22c55e}
.calc-inputs button{background:#22c55e;color:#fff;padding:0.875rem 2rem;border-radius:50px;border:none;font-weight:800;font-size:1rem;cursor:pointer;margin-top:0.5rem}
.calc-inputs button:hover{background:#16a34a}
.calc-result{text-align:center;padding:2rem;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-top:1.5rem}
table{width:100%;border-collapse:collapse;margin:1.5rem 0}
th,td{padding:0.6rem;border:1px solid #e2e8f0;text-align:left}
th{background:#f8fafc;font-weight:700}
</style>