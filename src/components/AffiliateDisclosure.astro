---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class={`ad ${compact ? 'ad-compact' : ''}`}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
  <p>
    <strong>Annonce:</strong> Dette indlæg indeholder affiliate-links. Køber du via et link,
    kan vi tjene en kommission — uden ekstra omkostning for dig. Det påvirker ikke vores anbefalinger.
    <a href="/om-affiliate">Læs mere</a>.
  </p>
</div>

<style>
  .ad{display:flex;align-items:flex-start;gap:.6rem;background:#f0fdf4;border:1px solid #bbf7d0;border-left:4px solid var(--accent);border-radius:0 var(--r) var(--r) 0;padding:.85rem 1.1rem;margin:0 0 .5rem}
  .ad svg{color:var(--accent-dk);flex-shrink:0;margin-top:.15rem}
  .ad p{font-size:.82rem;line-height:1.6;color:#166534;margin:0}
  .ad strong{color:#14532d;font-weight:800}
  .ad a{color:var(--accent-dk);font-weight:700;text-decoration:underline;text-underline-offset:2px}
  .ad-compact{padding:.6rem .9rem}
  .ad-compact p{font-size:.78rem}
</style>
