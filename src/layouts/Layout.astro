<script is:inline defer define:vars={{ headerSearchData }}>
(function() {
  var pages = JSON.parse(headerSearchData);
  var input = document.getElementById('header-search-input');
  var results = document.getElementById('header-search-results');
  var btn = document.getElementById('header-search-btn');
  if (!input || !results) return;

  function doSearch() {
    var q = input.value.toLowerCase().trim();
    if (q.length < 2) { results.style.display = 'none'; results.innerHTML = ''; return; }
    var matches = pages.filter(function(p) { return p.title.toLowerCase().indexOf(q) !== -1; }).slice(0, 8);
    if (matches.length === 0) {
      results.innerHTML = '<a href="javascript:void(0)" style="color:#94a3b8;cursor:default">Ingen resultater</a>';
    } else {
      results.innerHTML = matches.map(function(m) { return '<a href="' + m.url + '">' + m.title + '</a>'; }).join('');
    }
    results.style.display = 'block';
    return matches;
  }

  input.addEventListener('input', doSearch);
  input.addEventListener('focus', doSearch);

  btn.addEventListener('click', function(e) {
    e.preventDefault();
    var matches = doSearch();
    if (matches && matches.length > 0) window.location.href = matches[0].url;
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      var matches = doSearch();
      if (matches && matches.length > 0) window.location.href = matches[0].url;
    }
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.header-search')) results.style.display = 'none';
  });
})();
</script>
</body>
</html>
