---
import SEO from '../components/SEO.astro';
import { getCollection } from 'astro:content';

// Build search data for header search
const allBlog = await getCollection('blog');
const allGlossary = await getCollection('glossary');
const headerSearchData = JSON.stringify([
  ...allBlog.map(p => ({ title: p.data.title, url: `/blog/${p.slug}` })),
  ...allGlossary.map(e => ({ title: e.data.title, url: `/ordbog/${e.slug}` })),
]);

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  canonical?: string;
}
const { title, description = "Vejledning, Tests & Guides til træning & kost", image, type = 'website', publishedTime, modifiedTime, author, canonical } = Astro.props;
---
<!doctype html>
<html lang="da">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<SEO
  title={title}
  description={description}
  image={image}
  type={type}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  canonical={canonical}
/>
<link rel="preload" href="/fonts/inter.css" as="style" />
<link rel="stylesheet" href="/fonts/inter.css" media="print" onload="this.media='all'" />
<style is:global>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#fff;--surface:#f8fafc;--border:#e2e8f0;--text:#0f172a;--muted:#64748b;--accent:#22c55e;--accent-dk:#16a34a;--dark:#0a0f1e;--dark2:#111827;--r:12px}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
.container{width:100%;max-width:1200px;margin:0 auto;padding:0 1.25rem}
.site-header{position:sticky;top:0;z-index:100;background:var(--dark);border-bottom:1px solid rgba(255,255,255,.07)}
.header-inner{display:flex;align-items:center;justify-content:space-between;padding:.875rem 1.25rem;max-width:1200px;margin:0 auto}
.logo{font-size:1.2rem;font-weight:900;color:#fff;letter-spacing:-.03em}
.logo span{color:var(--accent)}
nav a{color:rgba(255,255,255,.65);font-size:.875rem;font-weight:500;margin-left:1.75rem;transition:color .15s}
nav a:hover{color:#fff}
.nav-toggle{display:none;background:none;border:none;cursor:pointer;color:#fff;padding:.25rem;line-height:0}
.mobile-menu{display:none;background:var(--dark2);border-top:1px solid rgba(255,255,255,.06)}
.mobile-menu a{display:block;padding:.875rem 1.25rem;color:rgba(255,255,255,.75);font-size:.95rem;font-weight:500;border-bottom:1px solid rgba(255,255,255,.04)}
.mobile-menu a:hover{color:#fff}
.mobile-menu.open{display:block}
@media(max-width:768px){nav{display:none}.nav-toggle{display:block}.header-search{display:block!important;flex:1;order:2;margin:0 .5rem}.header-search input{width:100%!important}.header-search-results{position:fixed;left:1rem;right:1rem;top:60px}.header-inner{flex-wrap:wrap}}
.hero{background:linear-gradient(150deg,var(--dark) 0%,#0d1f36 55%,#0a1f12 100%);color:#fff;padding:5rem 0 4.5rem;text-align:center;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% -10%,rgba(34,197,94,.15) 0%,transparent 70%)}
.hero .container{position:relative;z-index:1}
.hero h1{font-size:clamp(2rem,6vw,3.75rem);font-weight:900;line-height:1.05;letter-spacing:-.04em;margin-bottom:1.25rem}
.hero p{font-size:clamp(.95rem,2.5vw,1.15rem);color:rgba(255,255,255,.65);max-width:520px;margin:0 auto 2.25rem;line-height:1.7}
.hero-btn{display:inline-flex;align-items:center;background:var(--accent);color:#fff;padding:.9rem 2.25rem;border-radius:50px;font-weight:800;font-size:1rem;letter-spacing:-.01em;box-shadow:0 4px 24px rgba(34,197,94,.35);transition:transform .15s,box-shadow .15s}
.hero-btn:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(34,197,94,.45)}
.section{padding:3.5rem 0}
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem}
.section-header h2{font-size:1.5rem;font-weight:800;letter-spacing:-.025em}
.section-header a{color:var(--accent);font-size:.875rem;font-weight:700}
.category-hero{background:linear-gradient(150deg,var(--dark) 0%,#0d1f36 100%);color:#fff;padding:3.5rem 0 2.75rem}
.category-hero h1{font-size:clamp(1.75rem,5vw,2.75rem);font-weight:900;letter-spacing:-.04em;margin-bottom:.5rem}
.category-hero p{color:rgba(255,255,255,.65);font-size:1rem;max-width:560px}
.cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:1.5rem}
@media(max-width:480px){.cards-grid{gap:1rem}}
.card{background:var(--bg);border-radius:var(--r);border:1px solid var(--border);overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s;box-shadow:0 1px 3px rgba(0,0,0,.07)}
.card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.12)}
.card-img{aspect-ratio:16/9;overflow:hidden;background:#e2e8f0}
.card-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
.card:hover .card-img img{transform:scale(1.05)}
.card-body{padding:1.25rem 1.25rem 1.5rem;display:flex;flex-direction:column;gap:.5rem;flex:1}
.card-body h3{font-size:1rem;font-weight:700;line-height:1.35;letter-spacing:-.01em}
.card-body h3 a:hover{color:var(--accent)}
.card-excerpt{color:var(--muted);font-size:.875rem;line-height:1.65;flex:1;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.card-meta{display:flex;align-items:center;gap:.35rem;font-size:.78rem;color:var(--muted);padding-top:.25rem}
.card-meta .sep{opacity:.3}
.cat-card{background:var(--bg);border-radius:var(--r);border:1px solid var(--border);padding:1.5rem;transition:transform .2s,box-shadow .2s,border-color .2s;box-shadow:0 1px 3px rgba(0,0,0,.07);height:100%}
.cat-card:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,.1);border-color:var(--accent)}
.cat-icon{font-size:2rem;margin-bottom:.75rem}
.cat-name{font-weight:800;font-size:1rem;margin-bottom:.3rem;color:var(--text)}
.cat-desc{font-size:.85rem;color:var(--muted);line-height:1.5}
.badge{display:inline-block;padding:.28rem .85rem;border-radius:50px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;background:#e2e8f0;color:#475569}
[class*="ningsguide"]{background:#dbeafe;color:#1d4ed8}
.kosttilskudguides{background:#fef9c3;color:#854d0e}
.proteinopskrifter{background:#dcfce7;color:#15803d}
.artikler{background:#f3e8ff;color:#7e22ce}
.featured-post{display:grid;grid-template-columns:1fr 1fr;background:#fff;border-radius:var(--r);border:1px solid var(--border);overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.08)}
@media(max-width:768px){.featured-post{grid-template-columns:1fr}}
.fp-img{aspect-ratio:4/3;overflow:hidden;background:#e2e8f0;min-height:260px}
.fp-img img{width:100%;height:100%;object-fit:cover}
.fp-body{padding:2rem 2rem 2.5rem;display:flex;flex-direction:column;gap:.875rem;justify-content:center}
@media(max-width:768px){.fp-body{padding:1.5rem}}
.fp-body h2{font-size:clamp(1.25rem,3vw,1.85rem);font-weight:800;letter-spacing:-.025em;line-height:1.2}
.fp-body p{color:var(--muted);font-size:.95rem;line-height:1.65}
.read-more{display:inline-flex;align-items:center;gap:.4rem;background:var(--accent);color:#fff;padding:.7rem 1.5rem;border-radius:50px;font-weight:700;font-size:.875rem;width:fit-content;margin-top:.25rem;transition:background .15s}
.read-more:hover{background:var(--accent-dk)}
.category-nav{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:2rem}
.category-pill{padding:.45rem 1.1rem;border-radius:50px;border:1.5px solid var(--border);font-size:.82rem;font-weight:600;color:var(--muted);background:#fff;transition:all .15s}
.category-pill:hover,.category-pill.active{background:var(--accent);border-color:var(--accent);color:#fff}
.post-header{background:linear-gradient(150deg,var(--dark) 0%,#0d1f36 100%);color:#fff;padding:3rem 0 2.5rem}
.post-header .badge{margin-bottom:.75rem}
.post-header h1{font-size:clamp(1.6rem,5vw,2.75rem);font-weight:900;letter-spacing:-.035em;line-height:1.1;margin-bottom:.875rem;max-width:720px}
.post-meta{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;font-size:.84rem;color:rgba(255,255,255,.6)}
.post-meta strong{color:rgba(255,255,255,.9)}
.post-meta .sep{opacity:.4}
.post-cover{overflow:hidden;background:#111;max-height:480px}
.post-cover img{width:100%;max-height:480px;object-fit:cover}
.post-content{max-width:740px;margin:0 auto;padding:2.5rem 1.5rem 3rem}
.post-content h2{font-size:1.5rem;font-weight:800;margin:2.5rem 0 .875rem;letter-spacing:-.025em}
.post-content h3{font-size:1.2rem;font-weight:700;margin:2rem 0 .75rem}
.post-content h4{font-size:1rem;font-weight:700;margin:1.5rem 0 .5rem}
.post-content p{color:#334155;font-size:1.05rem;line-height:1.8;margin-bottom:1.25rem}
.post-content ul,.post-content ol{margin:0 0 1.25rem 1.5rem;color:#334155;font-size:1.05rem;line-height:1.8}
.post-content li{margin-bottom:.35rem}
.post-content strong{color:var(--text);font-weight:700}
.post-content a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
.post-content a:hover{color:var(--accent-dk)}
.post-content img{border-radius:var(--r);margin:2rem auto;box-shadow:0 4px 16px rgba(0,0,0,.1)}
.post-content iframe{max-width:100%;border-radius:var(--r);margin:1.5rem auto;display:block;aspect-ratio:16/9;width:100%;height:auto;border:0}
.post-content table{display:block;width:100%;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;border-collapse:collapse;margin:1.5rem 0;font-size:.95rem}
.post-content table th,.post-content table td{padding:.6rem .75rem;border:1px solid #e2e8f0;text-align:left;white-space:nowrap}
.post-content table th{background:#f8fafc;font-weight:700}
@media(max-width:480px){.post-content table{font-size:.85rem}.post-content table th,.post-content table td{padding:.45rem .5rem}}
.post-content blockquote{border-left:4px solid var(--accent);padding:.75rem 1.25rem;margin:1.5rem 0;background:#f0fdf4;border-radius:0 var(--r) var(--r) 0;color:#15803d;font-style:italic}
.back-link{display:block;border-top:1px solid var(--border);margin:0 auto;max-width:740px;padding:1.75rem 1.5rem}
.back-link a{color:var(--accent);font-weight:600;font-size:.875rem}
.back-link a:hover{text-decoration:underline}
.site-footer{background:var(--dark);color:rgba(255,255,255,.5);padding:3rem 0 1.5rem;margin-top:4rem}
.footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:2rem;margin-bottom:2.5rem}
.footer-col h4{color:#fff;font-size:.9rem;font-weight:700;margin-bottom:.875rem}
.footer-col ul{list-style:none}
.footer-col ul li{margin-bottom:.5rem}
.footer-col ul a{font-size:.85rem;color:rgba(255,255,255,.5);transition:color .15s}
.footer-col ul a:hover{color:#fff}
.footer-col p{font-size:.85rem;line-height:1.65}
.footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:1.5rem;font-size:.8rem;text-align:center}
.social-links{display:flex;gap:1rem}
.social-links a{color:rgba(255,255,255,.5);text-decoration:none;font-size:.9rem}
.social-links a:hover{color:#fff}
.header-search{position:relative;display:inline-block;margin:0 1rem}
.header-search input{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);color:#fff;border-radius:20px;padding:.5rem 2rem .5rem 1rem;font-size:.85rem;width:160px;outline:none;transition:width .2s,background .15s;box-sizing:border-box}
.header-search input::placeholder{color:rgba(255,255,255,.4)}
.header-search input:focus{width:220px;background:rgba(255,255,255,.12)}
.header-search-btn{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;color:rgba(255,255,255,.5);cursor:pointer;padding:0;display:flex;align-items:center}
.header-search-btn:hover{color:#fff}
.header-search-results{display:none;position:absolute;top:100%;right:0;left:0;background:#fff;border:1px solid #e2e8f0;border-radius:12px;margin-top:.5rem;box-shadow:0 8px 24px rgba(0,0,0,.15);z-index:200;overflow:hidden;max-height:400px;overflow-y:auto}
.header-search-results a{display:block;padding:.65rem 1rem;color:#0f172a;text-decoration:none;border-bottom:1px solid #f1f5f9;font-size:.85rem}
.header-search-results a:hover{background:#f8fafc;color:#22c55e}
@media (max-width:768px){.header-inner{flex-wrap:wrap}.logo{order:1}.nav-toggle{order:2}.header-search{order:3;flex:1 1 100%;margin:.5rem 0 0;display:block!important}.header-search input{width:100%!important;padding:.65rem 2.5rem .65rem 1rem}.header-search-results{position:fixed;left:1rem;right:1rem;top:64px}}
</style>
</head>
<body>
<header class="site-header" role="banner">
<div class="header-inner">
<a href="/" class="logo" aria-label="UrbanCoast.dk forside"><img src="/img/urban-coast-logo.png" alt="UrbanCoast.dk" height="40" style="height:40px;width:auto" /></a>
<div class="header-search">
<input type="text" id="header-search-input" placeholder="Søg..." autocomplete="off" aria-label="Søg" />
<button class="header-search-btn" id="header-search-btn" aria-label="Søg"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
<div id="header-search-results" class="header-search-results"></div>
</div>
<nav aria-label="Hovednavigation">
