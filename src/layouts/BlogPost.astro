---
import Layout from './Layout.astro';
import ExerciseAnimation from '../components/ExerciseAnimation.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  image?: string;
  animation?: string;
  toc?: boolean;
}
const { title, description, pubDate, updatedDate, author, category, image, animation, toc = false } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('da-DK', { year: 'numeric', month: 'long', day: 'numeric' }).format(pubDate);
const formattedUpdated = updatedDate ? new Intl.DateTimeFormat('da-DK', { year: 'numeric', month: 'long', day: 'numeric' }).format(updatedDate) : null;
const catSlug = category.toLowerCase().replace(/æ/g,'ae').replace(/ø/g,'oe').replace(/å/g,'aa').replace(/\s+/g,'-');
---
<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate ? updatedDate.toISOString() : pubDate.toISOString()}
  author={author}
>
  <div class="post-header">
    <div class="container">
      <div style="margin-bottom:.75rem">
        <a href={`/kategori/${catSlug}`} class={`badge ${catSlug}`}>{category}</a>
      </div>
      <h1>{title}</h1>
      <div class="post-meta">
        <span>Af <strong>{author}</strong></span>
        <span class="sep">&#183;</span>
        <span>{formattedDate}</span>
        {formattedUpdated && (
          <>
            <span class="sep">&#183;</span>
            <span>Opdateret: {formattedUpdated}</span>
          </>
        )}
      </div>
    </div>
  </div>

  {image && (
    <div class="post-cover">
      <img src={image} alt={title} width="1200" height="675" loading="eager" decoding="async" fetchpriority="high" />
    </div>
  )}

  {toc ? (
    <div class="post-layout">
      <aside class="post-toc-sidebar">
        <TableOfContents />
      </aside>
      <article class="post-content">
        {animation && (
          <ExerciseAnimation exercise={animation} />
        )}
        <slot />
      </article>
    </div>
  ) : (
    <article class="post-content">
      {animation && (
        <ExerciseAnimation exercise={animation} />
      )}
      <slot />
    </article>
  )}

  <div style="border-top:1px solid #e5e7eb;padding:2rem 0;margin:0 auto;max-width:780px;padding-left:1.5rem;padding-right:1.5rem">
    <a href="/blog" style="color:#0f3460;font-weight:600;font-size:.9rem">&#8592; Tilbage til alle indlæg</a>
  </div>
</Layout>

<style>
  .post-layout {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 2.5rem;
    align-items: start;
  }
  .post-layout .post-content {
    max-width: 100%;
    margin: 0;
    padding: 0;
  }
  .post-toc-sidebar {
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
  }
  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem 1.5rem 3rem;
    }
    .post-toc-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      order: -1;
    }
  }
</style>
