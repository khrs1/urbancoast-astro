---
import Layout from './Layout.astro';
import ProductBox from '../components/ProductBox.astro';
import ProductComparison from '../components/ProductComparison.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import { getProducts } from '../data/products';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  category: string;
  image?: string;
  products?: string[];
  comparison?: string[];
  comparisonTitle?: string;
  recommendationsTitle?: string;
}
const {
  title, description, pubDate, author, category, image,
  products = [], comparison = [], comparisonTitle, recommendationsTitle,
} = Astro.props;

const recommended = getProducts(products);
const compare = getProducts(comparison);
const hasAffiliate = recommended.length > 0 || compare.length > 0;

const formattedDate = new Intl.DateTimeFormat('da-DK', { year: 'numeric', month: 'long', day: 'numeric' }).format(pubDate);
const catSlug = category.toLowerCase().replace(/ae/g,'ae').replace(/oe/g,'oe').replace(/aa/g,'aa').replace(/\s+/g,'-');
---
<Layout title={title} description={description}>
  <div class="post-header">
    <div class="container">
      <div style="margin-bottom:.75rem">
        <a href={`/kategori/${category}`} class={`badge ${catSlug}`}>{category}</a>
      </div>
      <h1>{title}</h1>
      <div class="post-meta">
        <span>Af <strong>{author}</strong></span>
        <span class="sep">&#183;</span>
        <span>{formattedDate}</span>
      </div>
    </div>
  </div>

  {image && (
    <div class="post-cover">
      <img src={image} alt={title} />
    </div>
  )}

  {hasAffiliate && (
    <div class="post-disclosure">
      <AffiliateDisclosure />
    </div>
  )}

  <article class="post-content">
    <slot />
  </article>

  {compare.length > 0 && (
    <section class="post-affiliate">
      <ProductComparison products={compare} title={comparisonTitle ?? 'Sammenlign vores anbefalinger'} />
    </section>
  )}

  {recommended.length > 0 && (
    <section class="post-affiliate">
      <h2 class="aff-heading">{recommendationsTitle ?? 'Vores anbefalinger'}</h2>
      <div class="aff-grid">
        {recommended.map((p) => <ProductBox product={p} />)}
      </div>
      <AffiliateDisclosure compact />
    </section>
  )}

  <div class="back-link">
    <a href="/blog">&#8592; Tilbage til alle indlaeg</a>
  </div>
</Layout>

<style>
  .post-disclosure{max-width:740px;margin:0 auto;padding:1.5rem 1.5rem 0}
  .post-affiliate{max-width:740px;margin:0 auto;padding:1rem 1.5rem 1.5rem}
  .aff-heading{font-size:1.5rem;font-weight:800;letter-spacing:-.025em;margin:.5rem 0 1.25rem}
  .aff-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:1.25rem;margin-bottom:1.25rem}
</style>
